# Copie para .env e passe via --dart-define-from-file=.env
# ou: flutter run --dart-define=FIREBASE_API_KEY=... (etc.)

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Opcional: Groq (tier gratuito) — se vazio, usa Pollinations (sem chave) + oráculo local
GROQ_API_KEY=
