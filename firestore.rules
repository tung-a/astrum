rules_version = '2';

// =============================================================================
// Regras do Firestore do Astrum (T07).
//
// Plano gratuito: sem Cloud Functions, entao toda a seguranca esta aqui.
// O role 'admin' e atribuido manualmente no console (o cliente nao consegue
// altera-lo). Nao ha curinga amplo em users/{uid}/{document=**}: regras somam
// por OR e um curinga anularia as validacoes abaixo.
//
// LOJA: o preco vive em shop_items/{itemId} (escrita so do admin). Na compra o
//   item novo do inventario e o ultimo da lista (que nao pode ja estar no
//   inventario antigo) e o saldo novo deve ser EXATAMENTE saldo antigo menos o
//   preco do catalogo. Preco 0: saldo inalterado, item gratuito. Item sem doc
//   ativo em shop_items nao entra no inventario.
//
// RISCO RESIDUAL (limitacao conhecida):
//   O preco da compra e verificado e o TIPO do item agora tambem e verificado
//   pelo catalogo. Limitacoes que permanecem:
//   (1) Preco e ativacao dos itens JA existentes dependem so do cliente do
//   admin: a regra de shop_items nao protege price nem active ja gravados.
//   Isso e aceitavel neste modelo sem servidor, mas um admin comprometido pode
//   alterar precos.
//   (2) Os avatares gratuitos pfp_zodiac_* podem ser adicionados por qualquer
//   usuario (impacto nulo, pois custam 0).
//   (3) A FREQUENCIA de compra, que as regras nao limitam.
//   Tambem: o dia do check-in e validado em UTC com tolerancia de +-1 dia (o
//   app usa a data local); o limite e uma vez por data crescente.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    function pad(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function dateStr(t) {
      return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day());
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      function old() { return resource.data; }
      function nw() { return request.resource.data; }

      function oldStar() { return old().get('wallet', {}).get('stardust', 0); }
      function newStar() { return nw().wallet.stardust; }
      function oldInv() { return old().get('inventory', []); }
      function oldCheck() { return old().get('dailyCheckIn', ''); }
      function newCheck() { return nw().get('dailyCheckIn', ''); }

      function walletShapeOk() {
        return nw().wallet is map
          && nw().wallet.keys().hasOnly(['stardust'])
          && newStar() is int;
      }

      function roleUnchanged() {
        return nw().get('role', 'user') == old().get('role', 'user');
      }

      // Sem mudanca de saldo: inventario e dailyCheckIn tambem ficam fixos.
      function noEconomyChange() {
        return newStar() == oldStar()
          && nw().get('inventory', []) == oldInv()
          && newCheck() == oldCheck();
      }

      // (a) check-in: +25 exatos, data nova (crescente) = hoje (UTC +-1 dia).
      function isCheckin() {
        return newStar() == oldStar() + 25
          && nw().get('inventory', []) == oldInv()
          && newCheck() is string
          && newCheck() > oldCheck()
          && newCheck() in [
            dateStr(request.time - duration.value(1, 'd')),
            dateStr(request.time),
            dateStr(request.time + duration.value(1, 'd'))
          ];
      }

      // Doc do catalogo do item (so lido depois de checar que existe).
      function catalogPath(itemId) {
        return /databases/$(database)/documents/shop_items/$(itemId);
      }

      // (b) compra: inventario ganha exatamente 1 item (o ultimo da lista, que
      // nao estava no inventario antigo), o item esta ativo no catalogo e o
      // saldo novo == saldo antigo - preco do catalogo (preco 0: sem mudanca).
      function isPurchase() {
        return nw().inventory is list
          && nw().inventory.size() == oldInv().size() + 1
          && nw().inventory == oldInv().concat([nw().inventory[nw().inventory.size() - 1]])
          && !(nw().inventory[nw().inventory.size() - 1] in oldInv())
          && purchaseMatchesCatalog(nw().inventory[nw().inventory.size() - 1])
          && newCheck() == oldCheck();
      }

      function purchaseMatchesCatalog(itemId) {
        return itemId is string
          && exists(catalogPath(itemId))
          && get(catalogPath(itemId)).data.active == true
          && get(catalogPath(itemId)).data.price is int
          && get(catalogPath(itemId)).data.price >= 0
          && newStar() >= 0
          && newStar() == oldStar() - get(catalogPath(itemId)).data.price;
      }

      // ---- formato do perfil (lista fechada de campos que o app grava)
      // Campos opcionais: ausentes ou do tipo/tamanho certo.
      function optStr(k, maxLen) {
        return !(k in nw()) || (nw()[k] is string && nw()[k].size() <= maxLen);
      }

      function optMap(k, maxKeys) {
        return !(k in nw()) || (nw()[k] is map && nw()[k].size() <= maxKeys);
      }

      // equipped: so chaves conhecidas e cada valor precisa estar no inventario
      // (profilePicture pode ser null).
      // Item equipado: precisa ser do tipo certo no catalogo. Os dois itens
      // padrao (skin_classic, bg_void) valem sem consultar o catalogo.
      function equipTypeOk(id, type, builtin) {
        return id == builtin
          || (id is string
            && exists(catalogPath(id))
            && get(catalogPath(id)).data.type == type);
      }

      function equippedOk() {
        return !('equipped' in nw())
          || (nw().equipped is map
            && nw().equipped.keys().hasOnly(['skin', 'background', 'profilePicture'])
            && (!('skin' in nw().equipped)
              || (nw().equipped.skin in nw().get('inventory', [])
                && equipTypeOk(nw().equipped.skin, 'skin', 'skin_classic')))
            && (!('background' in nw().equipped)
              || (nw().equipped.background in nw().get('inventory', [])
                && equipTypeOk(nw().equipped.background, 'background', 'bg_void')))
            && (!('profilePicture' in nw().equipped)
              || nw().equipped.profilePicture == null
              || (nw().equipped.profilePicture in nw().get('inventory', [])
                && equipTypeOk(nw().equipped.profilePicture, 'profilePicture', ''))));
      }

      // Inventario inicial: so os dois itens padrao, ou eles mais um unico
      // avatar zodiacal gratuito e ativo do catalogo (pfp_zodiac_<signo>).
      function initialInvOk() {
        return nw().inventory is list
          && (nw().inventory == ['skin_classic', 'bg_void']
            || (nw().inventory.size() == 3
              && nw().inventory[0] == 'skin_classic'
              && nw().inventory[1] == 'bg_void'
              && nw().inventory[2] is string
              && nw().inventory[2].matches('^pfp_zodiac_[a-z]+$')
              && exists(catalogPath(nw().inventory[2]))
              && get(catalogPath(nw().inventory[2])).data.price == 0
              && get(catalogPath(nw().inventory[2])).data.type == 'profilePicture'
              && get(catalogPath(nw().inventory[2])).data.active == true));
      }

      function prefsOk() {
        return !('preferences' in nw())
          || (nw().preferences is map
            && nw().preferences.keys().hasOnly(['notifications', 'publicProfile', 'showSign'])
            && (!('notifications' in nw().preferences) || nw().preferences.notifications is bool)
            && (!('publicProfile' in nw().preferences) || nw().preferences.publicProfile is bool)
            && (!('showSign' in nw().preferences) || nw().preferences.showSign is bool));
      }

      function profileShapeOk() {
        return nw().keys().hasOnly([
            'name', 'email', 'role', 'zodiacSign', 'birthDate', 'birthTime',
            'birthPlace', 'astrologyData', 'astralMapJson', 'wallet', 'inventory',
            'equipped', 'preferences', 'dailyHoroscope', 'dailyTarot', 'dailyCheckIn'])
          && ('name' in nw() ? (nw().name is string && nw().name.size() >= 1 && nw().name.size() <= 100) : true)
          && optStr('email', 254)
          && optStr('zodiacSign', 30)
          && optStr('birthDate', 20)
          && optStr('birthTime', 10)
          && optStr('birthPlace', 200)
          && optStr('astralMapJson', 20000)
          && optMap('astrologyData', 5)
          && optMap('dailyHoroscope', 5)
          && optMap('dailyTarot', 5)
          && (!('inventory' in nw()) || (nw().inventory is list && nw().inventory.size() <= 500))
          && equippedOk()
          && prefsOk();
      }

      // Leitura: dono ou admin (inclui list/query do admin). Usuario comum nao
      // consegue consultar outros usuarios (ver regressao findUserByEmail).
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && profileShapeOk()
        && request.resource.data.role == 'user'
        && request.resource.data.wallet == {'stardust': 500}
        && initialInvOk()
        && !('dailyCheckIn' in request.resource.data);

      allow update: if isOwner(uid)
        && roleUnchanged()
        && profileShapeOk()
        && walletShapeOk()
        && (noEconomyChange() || isCheckin() || isPurchase());

      // Sem delete pelo cliente: apagar e recriar o perfil devolveria o saldo
      // inicial. Exclusao de conta (LGPD) precisa de decisao propria.
      allow delete: if false;

      // Subcolecoes: cada uma com regra propria (sem curinga).
      match /events/{id} {
        allow read, write: if isOwner(uid);
      }

      match /friends/{id} {
        allow read, write: if isOwner(uid);
      }

      // Notificacoes de intencao: um usuario logado so envia para quem esta na
      // PROPRIA lista de amigos (users/{remetente}/friends/{destinatario}, que e
      // o que o app grava em addFriend). A intencao vem de lista fixa (a mesma
      // de account_screen.dart), o rotulo e derivado do id e fromName deve ser
      // o nome do perfil do remetente: nada de texto livre. So o dono
      // le/marca/apaga.
      // Limite: a lista de amigos e gravavel pelo proprio remetente, entao a
      // amizade e auto-declarada (nao ha aceite do destinatario).
      match /notifications/{id} {
        function labelOk(intentionId, label) {
          return (intentionId == 'luz' && label == 'Luz')
            || (intentionId == 'coragem' && label == 'Coragem')
            || (intentionId == 'cura' && label == 'Cura')
            || (intentionId == 'clareza' && label == 'Clareza');
        }

        allow read, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(
            ['type', 'intentionId', 'intentionLabel', 'fromName', 'fromUid', 'read', 'createdAt'])
          && request.resource.data.type == 'intention'
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.intentionId is string
          && request.resource.data.intentionLabel is string
          && labelOk(request.resource.data.intentionId, request.resource.data.intentionLabel)
          && request.resource.data.fromName is string
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && request.resource.data.fromName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid))
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // Conversas do oraculo (docs/architecture/chat-sync.md). So o dono.
      match /conversations/{convId} {
        function validConv(d) {
          return d.keys().hasOnly(['title', 'createdAt', 'updatedAt', 'messageCount', 'schemaVersion'])
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
            && d.createdAt is timestamp && d.updatedAt is timestamp
            && d.messageCount is int && d.messageCount >= 0 && d.messageCount <= 500
            && d.schemaVersion == 1;
        }

        allow read: if isOwner(uid);
        // Na criacao o contador e 0 (ou 1, se a primeira mensagem vai no mesmo
        // batch). Depois so fica igual ou sobe exatamente 1; nunca diminui.
        allow create: if isOwner(uid) && validConv(request.resource.data)
          && request.resource.data.messageCount <= 1;
        allow update: if isOwner(uid) && validConv(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.messageCount == resource.data.messageCount
            || request.resource.data.messageCount == resource.data.messageCount + 1);
        allow delete: if isOwner(uid);

        // Mensagens imutaveis: create apenas. Delete so pelo dono, para a
        // limpeza em cascata ao apagar a conversa (feita pelo cliente).
        match /messages/{msgId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['role', 'text', 'createdAt'])
            && request.resource.data.role in ['user', 'model']
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 10000
            && request.resource.data.createdAt is timestamp
            && getAfter(/databases/$(database)/documents/users/$(uid)/conversations/$(convId)).data.messageCount <= 500
            // O contador da conversa sobe exatamente 1 no mesmo batch (ou a
            // conversa nasce no batch com contador 1): sem mensagem sem contar.
            // Um batch com varias mensagens da mesma conversa nao passa.
            && getAfter(/databases/$(database)/documents/users/$(uid)/conversations/$(convId)).data.messageCount
              == (exists(/databases/$(database)/documents/users/$(uid)/conversations/$(convId))
                ? get(/databases/$(database)/documents/users/$(uid)/conversations/$(convId)).data.messageCount + 1
                : 1);
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }
    }

    // ------------------------------------------------------ analytics_events
    // Create com userId do proprio usuario (ou 'anonymous' sem login, como o
    // app faz). Leitura so do admin (tela de admin); cliente comum nao le.
    match /analytics_events/{id} {
      allow create: if request.resource.data.keys().hasOnly(['eventName', 'userId', 'createdAt'])
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() >= 1
        && request.resource.data.eventName.size() <= 100
        && request.resource.data.userId is string
        && (request.resource.data.userId == (signedIn() ? request.auth.uid : 'anonymous'))
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ------------------------------------------------- cristais_propriedades
    // Escrita pela tela de admin (popular cristais). O app nao le a colecao.
    match /cristais_propriedades/{id} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------ shop_items
    // Catalogo da loja: preco e disponibilidade. Qualquer usuario logado le;
    // so o admin escreve (botao "Publicar catalogo" da tela de admin).
    match /shop_items/{itemId} {
      function validItem(d) {
        return d.keys().hasOnly(['price', 'type', 'rarity', 'active'])
          && d.price is int && d.price >= 0
          && d.type in ['skin', 'background', 'profilePicture']
          && d.rarity is string
          && d.active is bool;
      }

      allow read: if signedIn();
      allow create, update: if isAdmin() && validItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------- publicProfiles
    // Perfil publico minimo para a busca de amigo por e-mail: so nome, avatar e
    // SHA-256 do e-mail (hex, 64 chars). Qualquer logado le; so o dono escreve;
    // sem delete pelo cliente.
    match /publicProfiles/{uid} {
      function validPublic(d) {
        return d.keys().hasOnly(['name', 'avatar', 'emailHash'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.avatar is string && d.avatar.size() <= 100
          && d.emailHash is string
          && d.emailHash.matches('^[0-9a-f]{64}$');
      }

      allow read: if signedIn();
      allow create, update: if isOwner(uid) && validPublic(request.resource.data);
      allow delete: if false;
    }

    // Qualquer outro caminho: negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
